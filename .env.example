# Copy to .env.local and fill in the values marked <...>.
# Values already filled in match the sample dataset in examples/ (see
# docs/snowflake-setup.md), so only the account-specific ones need changing.
#
# For a run with no accounts at all, use .env.demo.example instead (pnpm demo).
#
# .env.local is for `next dev` and local Docker runs. A deployed environment
# reads every value from AWS Secrets Manager (<project>/<env>/app-config plus
# the credential secrets) through the ECS task definition. See bin/secrets.sh
# and docs/configuration.md.

# ---------------------------------------------------------------------------
# Snowflake connection
# ---------------------------------------------------------------------------
SNOWFLAKE_URL=https://<your-account>.snowflakecomputing.com
SNOWFLAKE_DATABASE=ISABEL_SAMPLE
SNOWFLAKE_SCHEMA=SECURITY
SNOWFLAKE_WAREHOUSE=ISABEL_WH
# Optional: separate host for Cortex chat completions (image text extraction).
# Defaults to SNOWFLAKE_URL.
# SNOWFLAKE_CORTEX_API_URL=

# Account identifier as <ORGANIZATION>-<ACCOUNT>, and the service user from
# examples/sql/01_setup.sql.
SNOWFLAKE_ACCOUNT=<your_account_identifier>
SNOWFLAKE_USER=ISABEL_APP

# Key-pair auth. The private key must be PKCS#8. Use ONE of:
#   - SNOWFLAKE_RSA_KEY: the key itself (PEM, base64 PEM, or PEM with \n escapes)
#   - SNOWFLAKE_RSA_KEY_PATH: a key file (default .key/rsa_key.p8)
SNOWFLAKE_RSA_KEY=
# SNOWFLAKE_RSA_KEY_PATH=.key/rsa_key.p8
# Leave empty if the key is not encrypted.
SNOWFLAKE_RSA_PASSPHRASE=

# ---------------------------------------------------------------------------
# Cortex Agents
# ---------------------------------------------------------------------------
# Agent names resolve against SNOWFLAKE_DATABASE/SCHEMA. OPUS/HAIKU are
# optional; the model selector hides models whose name is empty.
AGENT_NAME=ISABEL
OPUS_AGENT_NAME=ISABEL_OPUS
HAIKU_AGENT_NAME=ISABEL_HAIKU

# Format: @DATABASE.SCHEMA.STAGE/file.yaml
SEMANTIC_MODEL_PATH=@ISABEL_SAMPLE.SECURITY.MODELS/semantic_model.yaml
SEARCH_SERVICE_PATH=ISABEL_SAMPLE.SECURITY.VULNERABILITY_CATALOG_SEARCH

# Optional JSON array of starter prompts shown on the empty chat screen.
# Leave empty for the built-in questions about the sample dataset.
SUGGESTED_QUERIES=
# Optional link shown in the page header (a chat room, wiki or issue tracker).
SUPPORT_URL=

# ---------------------------------------------------------------------------
# Azure AD sign-in (NextAuth)
# ---------------------------------------------------------------------------
# NEXTAUTH_URL is also the base URL for share links.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>
AZURE_AD_CLIENT_ID=<azure_ad_client_id>
AZURE_AD_CLIENT_SECRET=<azure_ad_client_secret>
AZURE_AD_TENANT_ID=<azure_ad_tenant_id>

# ---------------------------------------------------------------------------
# Authorization (Azure AD group IDs)
# ---------------------------------------------------------------------------
# Comma-separated group IDs. Fail-closed: access is denied if these are unset.
ALLOWED_AZURE_AD_GROUPS=<group_id_1>,<group_id_2>
ADMIN_AZURE_AD_GROUPS=<admin_group_id>

# ---------------------------------------------------------------------------
# Service account API (v1)
# ---------------------------------------------------------------------------
# JSON array of allowlisted Azure AD client-credentials consumers. [] disables it.
OAUTH_SERVICE_ACCOUNTS=[]

# ---------------------------------------------------------------------------
# Optional: sensitivity label embedded in Excel exports (Microsoft Purview)
# ---------------------------------------------------------------------------
MIP_LABEL_ID=
MIP_TENANT_ID=
MIP_LABEL_NAME=

# ---------------------------------------------------------------------------
# Conversation storage (DynamoDB + S3 overflow)
# ---------------------------------------------------------------------------
# Local development uses DynamoDB Local and the local S3 store from docker-compose.yml:
#   docker compose up -d && node bin/setup-local-dynamodb.js && node bin/setup-local-s3.js
DYNAMODB_LOCAL=true

# Conversations larger than 350KB are stored in S3 instead of inline in
# DynamoDB (400KB item limit). Required in deployed environments; Terraform
# provisions <project>-<environment>-conversations.
CONVERSATION_S3_BUCKET=isabel-local-conversations
S3_ENDPOINT=http://127.0.0.1:9000
S3_LOCAL_ACCESS_KEY=local
S3_LOCAL_SECRET_KEY=local
