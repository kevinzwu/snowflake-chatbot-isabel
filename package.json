{
  "name": "isabel",
  "version": "0.1.0",
  "private": true,
  "description": "Chat interface for security vulnerability analytics on Snowflake Cortex Agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinzwu/snowflake-chatbot-isabel.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "demo:setup": "node bin/demo-setup.mjs",
    "demo": "node bin/demo-setup.mjs && next dev --turbopack",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "test:security": "vitest run tests/security/",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:smoke": "pnpm exec playwright test --grep @smoke",
    "test:e2e:api": "pnpm exec playwright test --grep @api",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "test:e2e:report": "pnpm exec playwright show-report",
    "qa:local": "E2E_BASE_URL=http://localhost:3000 pnpm exec playwright test",
    "test:prompt-qa": "vitest run --config vitest.config.prompt-qa.ts",
    "test:prompt-qa:watch": "vitest --config vitest.config.prompt-qa.ts",
    "test:schema-qa": "vitest run --config vitest.config.schema-qa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.999.0",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/lib-dynamodb": "^3.999.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "fast-deep-equal": "^3.1.3",
    "fetch-event-stream": "^0.1.5",
    "framer-motion": "^12.4.2",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.543.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^16.0.0",
    "react-vega": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "short-uuid": "^5.2.0",
    "sonner": "^1.7.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.0.0",
    "usehooks-ts": "^3.1.1",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/hast": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=4.0.0 <4.2.5": "4.2.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=6.0.0 <6.2.2": "6.2.2",
      "minimatch@>=7.0.0 <7.4.8": "7.4.8",
      "minimatch@>=8.0.0 <8.0.6": "8.0.6",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "fast-xml-parser@>=5.0.0 <5.7.0": "5.7.1",
      "fast-xml-builder@<1.1.7": "1.1.7",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "tmp": ">=0.2.6",
      "browserslist@<4.28.7": "4.28.7",
      "nanoid@<3.3.18": "3.3.18",
      "@babel/core@<7.29.7": "7.29.7",
      "ajv@<6.14.0": "6.14.0",
      "esbuild@<0.28.1": "0.28.1",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "uuid@<11.1.1": "11.1.1",
      "yaml@<1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "dompurify@<3.4.17": "3.4.17",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
