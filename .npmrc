# Use flat node_modules layout (like npm) instead of pnpm's default symlinked layout.
# Required because Next.js standalone output copies files but does NOT recreate
# pnpm's internal symlinks (e.g. .pnpm/pdf-parse@x/node_modules/pdfjs-dist → ...).
# Without this, serverExternalPackages fail at runtime in Docker with
# "Cannot find module" errors for transitive dependencies.
node-linker=hoisted
