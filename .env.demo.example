# Demo mode: run Isabel with no Azure AD and no Snowflake account.
#
#   pnpm demo
#
# copies this file to .env.local (if there is none), creates a throwaway key,
# starts DynamoDB Local and the local S3 store, and starts the dev server. Sign in with the
# "Dev Login" button. Answers come from canned data, not from Snowflake.
#
# DEV_AUTH and MOCK_SNOWFLAKE are ignored when NODE_ENV=production, and the
# server refuses to start if either is set there. Never use this file for a
# real deployment; start from .env.example instead.

DEV_AUTH=true
MOCK_SNOWFLAKE=true

# The dev user is placed in this group.
ALLOWED_AZURE_AD_GROUPS=local-dev
ADMIN_AZURE_AD_GROUPS=

NEXTAUTH_URL=http://localhost:3000
# bin/demo-setup.mjs fills this in.
NEXTAUTH_SECRET=

# The app calls "Snowflake" at this address, which the mock route serves.
# It must be an absolute URL because server-side calls reject relative ones.
SNOWFLAKE_URL=http://localhost:3000/api/mock-snowflake
SNOWFLAKE_DATABASE=ISABEL_SAMPLE
SNOWFLAKE_SCHEMA=SECURITY
SNOWFLAKE_WAREHOUSE=ISABEL_WH
SNOWFLAKE_ACCOUNT=DEMO
SNOWFLAKE_USER=DEMO
# Empty: the key is read from .key/rsa_key.p8, which bin/demo-setup.mjs generates.
# Only the mock ever sees tokens signed with it.
SNOWFLAKE_RSA_KEY=
SNOWFLAKE_RSA_PASSPHRASE=

AGENT_NAME=ISABEL
OPUS_AGENT_NAME=ISABEL_OPUS
HAIKU_AGENT_NAME=ISABEL_HAIKU
SEMANTIC_MODEL_PATH=@ISABEL_SAMPLE.SECURITY.MODELS/semantic_model.yaml
SEARCH_SERVICE_PATH=ISABEL_SAMPLE.SECURITY.VULNERABILITY_CATALOG_SEARCH

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
OAUTH_SERVICE_ACCOUNTS=[]

# Local conversation storage (docker-compose.yml starts both).
DYNAMODB_LOCAL=true
CONVERSATION_S3_BUCKET=isabel-local-conversations
S3_ENDPOINT=http://127.0.0.1:9000
S3_LOCAL_ACCESS_KEY=local
S3_LOCAL_SECRET_KEY=local
