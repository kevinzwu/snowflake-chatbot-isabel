# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-results.json
tests/prompt-qa/results.json
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keys
.key/

# Playwright
playwright-report/
playwright/.auth/
test-results/
blob-report/

# Terraform files
.terraform/
# Real backend and variable files stay local; the examples are tracked.
# .terraform.lock.hcl is tracked on purpose (provider checksums).
backend.hcl
*.tfvars
!example.tfvars
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan*
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
